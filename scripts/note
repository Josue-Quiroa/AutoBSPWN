#!/usr/bin/env bash
# AutoBSPWN v3.4.0 — note <texto…>: one-line note for the active target (~/targets/<ip>/notes.md)
# or ~/notes/inbox.md when there is none. Without text it opens the Super+Alt+n popup.
q="$HOME/.config/bspwm/scripts/quick-note.sh"
[ -x "$q" ] || q="$(dirname "$(readlink -f "$0")")/../config/bspwm/scripts/quick-note.sh"
exec "$q" "$@"
