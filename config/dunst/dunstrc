# AutoBSPWN dunst v3.2.0
[global]
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    width = 320
    height = 300
    offset = 16x60
    origin = top-right
    transparency = 8
    idle_threshold = 120
    follow = mouse
    sticky_history = yes
    history_length = 32
    icon_position = left
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    max_icon_size = 48
    frame_width = 2
    # frame_color per urgency lives in the theme-sync block below
    separator_color = frame
    corner_radius = 12
    padding = 12
    horizontal_padding = 14
    gap_size = 6

# >>> autobspwn-theme (theme-sync: mocha) — no editar este bloque
[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#6c7086"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    timeout = 7

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
# <<< autobspwn-theme
